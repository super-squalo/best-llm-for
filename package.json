{
  "name": "best-llm-for",
  "version": "0.1.0",
  "description": "Which model is best for what you are doing, and what it costs - answered in your terminal, with the source behind every number.",
  "keywords": [
    "llm",
    "leaderboard",
    "pricing",
    "model-selection",
    "cli",
    "benchmark",
    "ai",
    "cost"
  ],
  "license": "MIT",
  "author": "Super Squalo",
  "type": "module",
  "bin": {
    "best-llm-for": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data",
    "skill"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "collect": "tsx scripts/collect.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "site": "tsx scripts/site.ts",
    "update": "npm run collect && npm run cards && npm run independent && npm run grid && npm run site",
    "grid": "tsx scripts/grid.ts",
    "independent": "tsx scripts/independent.ts",
    "cards": "tsx scripts/cards.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/super-squalo/best-llm-for.git"
  },
  "homepage": "https://super-squalo.github.io/best-llm-for/",
  "bugs": {
    "url": "https://github.com/super-squalo/best-llm-for/issues"
  }
}
